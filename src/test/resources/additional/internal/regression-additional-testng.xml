<!-- شرح الملف: يحدد مجموعة تشغيل منفصلة لمراجعة كل الحالات المعتمدة للمراجعة الشاملة. -->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  جزء Regression للبيانات الأساسية والقيود اليومية واختبار تعريف ملفات التشغيل محلياً.
  البيانات الأساسية والقيود اليومية تستخدم تجهيز وعزل وتنظيف بياناتها وتُشغّل من مداخلها الموحدة.
  اختبارات المصادقة ذات الجلسات المستقلة موجودة في login-testng.xml؛ الدخول هنا يحدث في BaseTest لكل سويت واجهة.
  الاختبارات المعطلة أصلاً تظل معطلة، ونجاح اختبار يرصد عيباً موثقاً لا يصحح سلوك التطبيق.
-->
<suite name="Regression - Basic data and general journal" parallel="none" configfailurepolicy="continue">
    <suite-files>
        <suite-file path="../../basic-data-testng.xml"/>
        <suite-file path="../../general-accounting-testng.xml"/>
    </suite-files>

</suite>

<?xml version="1.0" encoding="UTF-8"?>
<!-- شرح الملف: يحدد مجموعة مراجعة منفصلة للتأكد من استمرار خطوات الشاشات وتجهيز بياناتها وتنظيفها. -->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Live checks: two cases per class, a new browser for each class, owned fixture cleanup. -->
<suite name="Browser isolation across ERP screens" parallel="none" configfailurepolicy="continue">
    <test name="Page lifecycle and conditional waits" preserve-order="true">
        <classes>
            <class name="ProductsTest.UnitTest">
                <methods>
                    <include name="AddNewUnite"/>
                    <include name="PR_CancelNew"/>
                </methods>
            </class>
            <class name="DealerModelTest.CustomersTest">
                <methods>
                    <include name="CU_002_CloseCustomerFormWithoutSaving"/>
                    <include name="SaveWithOutArabicName"/>
                </methods>
            </class>
            <class name="Invoice.SalesInvoiceCoverageTest">
                <methods>
                    <include name="savesOwnedItemFromPicker"/>
                    <include name="emptyDocumentCannotSave"/>
                </methods>
            </class>
            <class name="Purches.PurchaseInvoiceCoverageTest">
                <methods>
                    <include name="savesOwnedItemFromPicker"/>
                    <include name="emptyDocumentCannotSave"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>

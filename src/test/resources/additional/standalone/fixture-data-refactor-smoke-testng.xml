<?xml version="1.0" encoding="UTF-8"?>
<!-- شرح الملف: يحدد مجموعة تشغيل منفصلة لمراجعة مراجعة الخطوات الأساسية بسرعة. -->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Live ERP: owned product, dealer and financial fixtures; includes page cleanup. -->
<suite name="Products dealers and finance fixture smoke" parallel="none" configfailurepolicy="continue">
    <test name="Owned master data and financial allocation" preserve-order="true">
        <classes>
            <class name="ProductsTest.UnitTest">
                <methods>
                    <include name="AddNewUnite"/>
                    <include name="AddUniteWithoutArabicName"/>
                </methods>
            </class>
            <class name="ProductsTest.AddProductsTest">
                <methods>
                    <include name="addNewProductWithValidData"/>
                    <include name="AddProductWithOutCategory"/>
                </methods>
            </class>
            <class name="DealerModelTest.DealerTestDataTest">
                <methods>
                    <include name="createLinkedFixturesInCurrentTenant"/>
                </methods>
            </class>
            <class name="DealerModelTest.CustomersTest">
                <methods>
                    <include name="AddCustomerFirstPage"/>
                    <include name="CU_002_CloseCustomerFormWithoutSaving"/>
                </methods>
            </class>
            <class name="FinancialMovementsTest.FinancialFixtureTest">
                <methods>
                    <include name="createdFixturesAppearInFinancialLookups"/>
                </methods>
            </class>
            <class name="FinancialMovementsTest.CustomerReceiptTest">
                <methods>
                    <include name="AddCustomerWithSaveAndCustomerReceiptTest"/>
                    <include name="FM_RejectZeroAmount"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>

<?xml version="1.0" encoding="UTF-8"?>
<!-- شرح الملف: يحدد مجموعة تشغيل منفصلة لمراجعة مراجعة الخطوات الأساسية بسرعة. -->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Live ERP checks: creates owned fixtures and cleans each class before closing its browser. -->
<suite name="Warehouse and special sales fixture smoke" parallel="none" configfailurepolicy="continue">
    <test name="Owned fixtures, persistence and branch defaults" preserve-order="true">
        <classes>
            <class name="StoreTest.ExchangeOrderTest">
                <methods>
                    <include name="AddExchangeWithItemsList"/>
                    <include name="AssertErrorWhenSavingWithoutProducts"/>
                </methods>
            </class>
            <class name="StoreTest.ManufacturingTest">
                <methods>
                    <include name="AddManufacturingTest"/>
                    <include name="AssertStoreRequired"/>
                </methods>
            </class>
            <class name="SpecialSalesTest.PointOfSaleTest">
                <methods>
                    <include name="ownedDefaultsAndChannel"/>
                    <include name="savesCashWithOwnedPayment"/>
                </methods>
            </class>
            <class name="SpecialSalesTest.RestaurantInvoiceTest">
                <methods>
                    <include name="ownedDefaultsAndChannel"/>
                    <include name="holdDeductsStockImmediately"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>

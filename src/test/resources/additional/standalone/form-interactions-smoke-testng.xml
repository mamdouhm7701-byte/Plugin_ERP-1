<?xml version="1.0" encoding="UTF-8"?>
<!-- شرح الملف: يحدد مجموعة تشغيل منفصلة لمراجعة مراجعة الخطوات الأساسية بسرعة. -->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Shared form interactions" parallel="none" configfailurepolicy="continue">
    <test name="Sales purchase and manufacturing forms" preserve-order="true">
        <classes>
            <class name="Invoice.SalesInvoiceCoverageTest">
                <methods>
                    <include name="savesOwnedItemFromPicker"/>
                    <include name="emptyDocumentCannotSave"/>
                </methods>
            </class>
            <class name="Purches.PurchaseInvoiceCoverageTest">
                <methods>
                    <include name="savesOwnedItemFromPicker"/>
                    <include name="emptyDocumentCannotSave"/>
                </methods>
            </class>
            <class name="StoreTest.ManufacturingTest">
                <methods>
                    <include name="AddManufacturingTest"/>
                    <include name="AssertStoreRequired"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>

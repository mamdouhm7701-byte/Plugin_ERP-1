<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Same-branch pilot only, not the full Regression suite.
     Three independent screens, one owned-data scenario per browser.
     Keep methods within each test sequential. No branch defaults, stock or payments.
     Do not run another live suite against this branch while the pilot is running. -->
<suite name="Parallel pilot - three independent screens" parallel="tests" thread-count="3"
       data-provider-thread-count="1" configfailurepolicy="continue">
    <test name="Browser 1 - Units" parallel="none" preserve-order="true">
        <classes><class name="ProductsTest.UnitTest"><methods>
            <include name="AddNewUnite"/>
        </methods></class></classes>
    </test>
    <test name="Browser 2 - Banks" parallel="none" preserve-order="true">
        <classes><class name="Plugin_ERP.Tests.LoginTest.BasicDataTest.BankTest"><methods>
            <include name="BK_003_CreateBankAndVerifySavedFields"/>
        </methods></class></classes>
    </test>
    <test name="Browser 3 - Customer classifications" parallel="none" preserve-order="true">
        <classes><class name="DealerModelTest.CustomerClassificationTest"><methods>
            <include name="CC_005_OwnedClassificationCreateEditDelete"/>
        </methods></class></classes>
    </test>
</suite>

<?xml version="1.0" encoding="UTF-8"?>
<!-- شرح الملف: يحدد مجموعة مراجعة منفصلة للتأكد من استمرار خطوات الشاشات وتجهيز بياناتها وتنظيفها. -->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Reviewed independent master screens on one branch. Not full Regression.
     Methods and cleanup within each lane stay sequential. Run alone against the branch.
     Do not include this alongside the original modules: that would duplicate cases. -->
<suite name="Parallel screens - three independent screens" parallel="tests" thread-count="3"
       data-provider-thread-count="1" configfailurepolicy="continue">
    <test name="Browser 1 - Units" parallel="none" preserve-order="true">
        <classes><class name="ProductsTest.UnitTest"/></classes>
    </test>
    <test name="Browser 2 - Banks" parallel="none" preserve-order="true">
        <classes><class name="Plugin_ERP.Tests.LoginTest.BasicDataTest.BankTest"/></classes>
    </test>
    <test name="Browser 3 - Customer classifications" parallel="none" preserve-order="true">
        <classes><class name="DealerModelTest.CustomerClassificationTest"/></classes>
    </test>
</suite>

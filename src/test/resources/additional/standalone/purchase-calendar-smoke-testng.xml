<?xml version="1.0" encoding="UTF-8"?>
<!-- شرح الملف: يحدد مجموعة تشغيل منفصلة لمراجعة مراجعة الخطوات الأساسية بسرعة. -->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Live ERP: owned supplier scope and datepicker filtering; includes class cleanup. -->
<suite name="Purchase calendar fixture smoke" parallel="none" configfailurepolicy="continue">
    <test name="Owned purchase list scope and date range" preserve-order="true">
        <classes>
            <class name="Purches.PurchaseListCoverageTest">
                <methods>
                    <include name="supplierFilterIsOwned"/>
                    <include name="dateRangeDoesNotLeaveStaleRows"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>

<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Regression إعادة التغطية الواسعة بعد تغييرات مهمة أو قبل إصدار.
  الفائدة: اكتشاف تأثر وظائف قائمة خارج نطاق التغيير، بما يشمل الحدود والحسابات والتنظيف.
  نعيد استخدام ملفات الموديولات الأساسية للحفاظ على تعريف واحد للتغطية.
  مداخل compatibility لا تضاف لأنها تكرر عقوداً موجودة. E2E مضمنة أيضاً في هذا التشغيل.
  special-sales-testng.xml هو مدخل نقاط البيع والمطعم مع اختبارات تنظيفهما المحلية.
  لا نضيف المدخلين المنفصلين للشاشتين معه حتى لا تتكرر الحالات.
  البيانات الأساسية والقيود اليومية الإضافية موضحة في additional/internal/regression-additional-testng.xml.
  التشغيل تسلسلي: لكل كلاس WebDriver مستقل، وتشارك حالاته بياناته الثابتة حتى تنظيف الكلاس.
  لا تشغل حالات الكلاس أو مجموعات كتابة لنفس الفرع بالتوازي.
  النتائج القديمة ليست ضمان نجاح؛ العيوب المعروفة تظل ظاهرة في هذا التشغيل.
  أسعار الأصناف: products يختار 11 حالة تشمل الصفر والتساوي، ورسالة الحقل مع منع الحفظ.
  حالات الرفض السبع تظل مفعّلة؛ لا نستثنيها بسبب عيوب التطبيق المعروفة.
  coverage-expansion يضم جميع حالات الشاشات الجديدة. الخزينة وExcel والطباعة وخط السير
  تأتي من مداخل موديولاتها، والرحلات الجديدة موجودة بالفعل هناك وفي expansion؛ لا نكرر E2E كاملة.
  التشغيل المقسم الآمن على Headless: ./scripts/Test-Project.ps1 -Mode Regression -Workers 3
  المدخل يحافظ على اختيار هذا الملف ويولد جزءًا للكلاسات المستقلة بالتوازي وجزءًا منفردًا للاستثناءات.
  تشغيل XML مباشرة يظل تسلسليًا: mvn '-Dsurefire.suiteXmlFiles=src/test/resources/regression-testng.xml' test
-->
<suite name="Regression - Core modules and workflows" parallel="none" configfailurepolicy="continue">
    <suite-files>
        <suite-file path="report-navigation-testng.xml"/>
        <suite-file path="coverage-expansion-testng.xml"/>
        <suite-file path="products-testng.xml"/>
        <suite-file path="dealer-model-testng.xml"/>
        <suite-file path="store-testng.xml"/>
        <suite-file path="financial-movements-testng.xml"/>
        <suite-file path="sales-testng.xml"/>
        <suite-file path="purchases-testng.xml"/>
        <suite-file path="special-sales-testng.xml"/>
        <suite-file path="additional/internal/regression-additional-testng.xml"/>
        <suite-file path="additional/internal/regression-workflows-testng.xml"/>
    </suite-files>
</suite>

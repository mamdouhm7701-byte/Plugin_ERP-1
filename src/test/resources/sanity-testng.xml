<?xml version='1.0' encoding='UTF-8'?>
<!-- شرح الملف: يحدد الحالات المختارة لتشغيل مراجعة الوظائف المهمة بعد التعديل. -->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Sanity تحقق مركز بعد تعديل صغير أو إصلاح، قبل إعادة Regression كاملة.
  الفائدة: التأكد من المسار المتأثر ومن قواعد قريبة منه مثل الحفظ والرفض والإلغاء.
  كل test أدناه يمثل نطاق تغيير. من IDE شغّل النطاق المقصود، أو احتفظ بعنصر test الخاص
  به وحده في نسخة محلية من الملف. تشغيل الملف كاملاً ينفذ كل النطاقات أدناه.
  ليست بديلاً عن إعادة حالة العيب نفسها: أضف اسم حالة العيب للنطاق المناسب عند الحاجة.
  النطاق: 56 حالة موزعة على نطاقات التغيير، تشمل الشاشات الجديدة والصلاحيات
  والجرد والتسويات والخزينة والطباعة ومحتوى Excel. شغّل نطاق التغيير المقصود للتحقق المركز.
  تعليق المطعم يخصم المخزون، بينما تعليق سلة نقاط البيع محلي؛ لا نساوي السلوكين.
  التشغيل: mvn '-Dsurefire.suiteXmlFiles=src/test/resources/sanity-testng.xml' test
-->
<suite name="Sanity - Focused checks by changed module" parallel="none" configfailurepolicy="continue">
    <!-- Explicit branch profile adds matching business contracts; ERP - Business run prepares a fresh branch. -->
    <parameter name="business.level" value="Sanity"/>
    <listeners><listener class-name="SuiteSupport.BusinessLevelSuitePolicy"/></listeners>
    <test name="Sanity Products" preserve-order="true">
        <classes>
            <class name="ProductsTest.AddProductsTest">
                <methods>
                    <include name="PR_SimpleProduct"/>
                    <include name="AddProductWithOutUnit"/>
                    <include name="PR_CancelEdit"/>
                </methods>
            </class>
            <class name="ProductsTest.ProductListTest"><methods>
                <include name="PR_SaveWithoutPrint"/><include name="AssertErorrMsg"/>
            </methods></class>
        </classes>
    </test>
    <test name="Sanity Dealers" preserve-order="true">
        <classes>
            <class name="DealerModelTest.CustomersTest">
                <methods>
                    <include name="CU_001_CustomerListStructure"/>
                    <include name="CU_003_CancelCustomerEditWithoutSaving"/>
                    <include name="CU_005_OwnedCustomerCreateEditDelete"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Sanity Sales" preserve-order="true">
        <classes>
            <class name="Invoice.SalesInvoiceCoverageTest">
                <methods>
                    <include name="savesOwnedItemFromPicker"/>
                    <include name="emptyDocumentCannotSave"/>
                    <include name="savedDocumentEditPolicy"/>
                    <include name="savesAndPrintsOwnedInvoice"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Sanity Purchases" preserve-order="true">
        <classes>
            <class name="Purches.PurchaseInvoiceCoverageTest">
                <methods>
                    <include name="savesOwnedItemFromPicker"/>
                    <include name="negativeQuantityCannotSave"/>
                    <include name="savedDocumentCanBeEdited"/>
                    <include name="savesAndPrintsOwnedDocument"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Sanity Stores" preserve-order="true">
        <classes>
            <class name="StoreTest.TransBetweenStoreTest">
                <methods>
                    <include name="SM_DecimalQuantity"/>
                    <include name="CantChosenSameStore"/>
                    <include name="SM_CancelEdit"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Sanity Financial movements" preserve-order="true">
        <classes>
            <class name="FinancialMovementsTest.CustomerReceiptTest">
                <methods>
                    <include name="AddResetWithSaveTest"/>
                    <include name="FM_RejectNegativeAmount"/>
                    <include name="FM_CancelEditWithoutSaving"/>
                    <include name="FM_ExportExcel"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Sanity Point of sale" preserve-order="true">
        <classes>
            <class name="SpecialSalesTest.PointOfSaleTest">
                <methods>
                    <include name="savesCashWithOwnedPayment"/>
                    <include name="savesCreditAndDeductsStock"/>
                    <include name="cancellingDeleteKeepsInvoice"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Sanity Restaurant" preserve-order="true">
        <classes>
            <class name="SpecialSalesTest.RestaurantInvoiceTest">
                <methods>
                    <include name="savesPaidExternalOrder"/>
                    <include name="addingToHoldDeductsOnlyIncrement"/>
                    <include name="payingHoldDoesNotDeductAgain"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Sanity New basic data and account masters" preserve-order="true"><classes>
        <class name="CoverageTest.TablesCoverageTest"><methods>
            <include name="createsAndReadsBackExactOwnedRecord"/><include name="missingRequiredFieldCannotPersist"/><include name="abandoningFormDoesNotSave"/>
        </methods></class>
        <class name="CoverageTest.AccountGroupsCoverageTest"><methods>
            <include name="createsAndReadsBackExactOwnedRecord"/><include name="missingRequiredFieldCannotPersist"/><include name="abandoningFormDoesNotSave"/>
        </methods></class>
        <class name="CoverageTest.CostCentersCoverageTest"><methods>
            <include name="createsAndReadsBackExactOwnedRecord"/><include name="missingRequiredFieldCannotPersist"/><include name="abandoningFormDoesNotSave"/>
        </methods></class>
        <class name="CoverageTest.ChartOfAccountsCoverageTest"><methods>
            <include name="createsAndReadsBackExactOwnedRecord"/><include name="missingRequiredFieldCannotPersist"/><include name="abandoningFormDoesNotSave"/>
        </methods></class>
    </classes></test>
    <test name="Sanity Inventory reconciliation" preserve-order="true"><classes>
        <class name="StoreTest.StocktakingCoverageTest"><methods>
            <include name="savesFractionalQuantityAndChecksStockEffect"/><include name="cancelCreationPreservesStock"/>
        </methods></class>
        <class name="StoreTest.ShortageAdjustmentCoverageTest"><methods><include name="generatedFractionalAdjustmentMatchesOwnedItemAndStock"/></methods></class>
        <class name="StoreTest.OverflowAdjustmentCoverageTest"><methods><include name="generatedFractionalAdjustmentMatchesOwnedItemAndStock"/></methods></class>
    </classes></test>
    <test name="Sanity Under review and invoice actions" preserve-order="true"><classes>
        <class name="Invoice.UnderReviewCoverageTest"><methods>
            <include name="savesUnderReviewWithoutPostingInventory"/><include name="zeroQuantityCannotPersist"/>
        </methods></class>
        <class name="Invoice.PostingCoverageTest"/>
        <class name="Invoice.ActionsCoverageTest"/>
    </classes></test>
    <test name="Sanity Kitchen fulfilment" preserve-order="true"><classes>
        <class name="SpecialSalesTest.KitchenOrdersCoverageTest"/>
    </classes></test>
    <test name="Sanity Users and direct access" preserve-order="true"><classes>
        <class name="CoverageTest.UsersCoverageTest"><methods>
            <include name="createsLimitedUserAndReadsBack"/><include name="mismatchedPasswordsCannotSave"/>
        </methods></class>
        <class name="CoverageTest.PermissionsCoverageTest"/>
        <class name="CoverageTest.ZatcaConfigurationCoverageTest"/>
    </classes></test>
    <test name="Sanity Treasury cash ledger and closing" preserve-order="true"><classes>
        <class name="FinancialMovementsTest.TreasuryLedgerCoverageTest"/>
    </classes></test>
</suite>

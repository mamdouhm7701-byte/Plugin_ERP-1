<?xml version='1.0' encoding='UTF-8'?>
<!-- شرح الملف: يحدد الحالات المختارة لتشغيل المطعم ونقاط البيع. -->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  المدخل الشامل لقناتي الكاشير: 15 حالة نقاط بيع و15 مطعم وتنفذ اختبارات التنظيف المحلية منفصلة في ci-testng.xml.
  Regression يضم هذا الملف مرة واحدة. لا تضمه مع additional/standalone/point-of-sale-testng.xml أو additional/standalone/restaurant-testng.xml.
  السيناريوهات مستقلة ببياناتها؛ إعدادات الفرع المؤقتة تستعاد بعد كل حالة والتنظيف بعد كل كلاس.
  النتائج الموثقة سابقاً ليست نتيجة جديدة؛ أخطاء التطبيق المعروفة تبقى ضمن التغطية.
-->
<suite name="Special sales - Point of sale and restaurant" parallel="none" configfailurepolicy="continue">
    <test name="Point of sale - Full page coverage" preserve-order="true">
        <classes>
            <class name="SpecialSalesTest.PointOfSaleTest"/>
        </classes>
    </test>
    <test name="Restaurant - Full page coverage" preserve-order="true">
        <classes>
            <class name="SpecialSalesTest.RestaurantInvoiceTest"/>
        </classes>
    </test>

</suite>
